# Every key the backend needs, names only. Copy to .env and fill in for local dev.
# Prod on Fly gets real values from Fly secrets (managed by ob1-can-obi).
# OPENAI_API_KEY=

# MaC runner settings for running pipelines locally (see docs/runner.md). Names only.
# GITHUB_TOKEN=
# ATLASSIAN_SITE=
# ATLASSIAN_EMAIL=
# ATLASSIAN_API_TOKEN=
# CONFLUENCE_SPACE_KEY=
# NVIDIA_API_KEY=
# MAC_LLM_MODEL=      (optional; defaults to nvidia/nemotron-3-ultra-550b-a55b)
# MAC_LLM_BASE_URL=   (optional; defaults to NVIDIA NIM)
# MAC_TF_STATE_BUCKET=
# MAC_TF_STATE_REGION=
# AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# The knowledge base the AI help cites (default: demo-data/confluence in the repo)
# MAC_KNOWLEDGE_DIR=

# Approvals follow Jira on their own: the server asks Jira every N seconds (default 30; 0 = off),
# and Jira can push changes to POST /api/mac/jira/webhook?token=<secret> (docs/cloud-setup.md).
# MAC_APPROVAL_POLL_SECONDS=30
# MAC_JIRA_WEBHOOK_SECRET=

# Sign in with GitHub on the live console (only needed where APP_ENV=production). Names only.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# MAC_GITHUB_REPO=
