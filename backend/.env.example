# Every key the backend needs, names only. Copy to .env and fill in for local dev.
# Prod on Fly gets real values from Fly secrets (managed by ob1-can-obi).
# OPENAI_API_KEY=

# MaC runner settings for running pipelines locally (see docs/runner.md). Names only.
# GITHUB_TOKEN=
# ATLASSIAN_SITE=
# ATLASSIAN_EMAIL=
# ATLASSIAN_API_TOKEN=
# CONFLUENCE_SPACE_KEY=
# NVIDIA_API_KEY=
# MAC_TF_STATE_BUCKET=
# MAC_TF_STATE_REGION=
# AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
